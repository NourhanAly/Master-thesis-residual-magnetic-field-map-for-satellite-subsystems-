function[RR] = FitFnc(X)
Xs = -5; Xe = 5; Ys = -5 ; Ye = 5; Zs = -15; Ze = 15;
mue0 = 1.25663753*10^-6;
load('EPS_new.mat')
[a b c] = size(B_EPS);
Xincr = (Xe - Xs)/(a-1);
Yincr = (Ye - Ys)/(b-1);
Zincr = (Ze - Zs)/(c-1);
mu_a = [X(1) X(7)]; mu_b = [X(2)  X(8)]; mu_c = [X(3) X(9)];
m = [X(4) X(10)]; n = [X(5) X(11)]; p = [X(6) X(12)];
S = norm([m ;n ;p]); e = [m;n;p]/S;
m = e(1, :); n = e(2,:); p = e(3,:);
for h = 1 : length(m)
    for i = 1 : a
        for j = 1 : b
            for k = 1 : c
                Ref = [(Xs+((i-1)*Xincr)), (Ys+((j-1)*Yincr)) , (Zs+((k-1)*Zincr))];
                R = sqrt((Ref(1) - mu_a(h))^2 + (Ref(2) - mu_b(h))^2 + (Ref(3) - mu_c(h))^2);
                C1 = mue0*S(h)/(4*pi); C2 = m(h)*(Ref(1)-mu_a(h)) + n*(Ref(2)-mu_b(h)) + p*(Ref(3)-mu_c(h));
                Bx(i , j , k) = C1*(3*(Ref(1)-mu_a(h))*C2/R^5)- C1*(m/R^3);
                By(i , j , k) = C1*(3*(Ref(2)-mu_b)*C2/R^5)- C1*(n/R^3);
                Bz(i , j , k) = C1*(3*(Ref(3)-mu_c)*C2/R^5)- C1*(p/R^3);
                B(i , j , k) = norm([Bx(i , j , k) , By(i , j , k) , Bz(i , j , k)]);
            
            end
         end
    end
end
RMS = sqrt(sum((B - B_EPS).^2 , 'all'));
RMS_x = sqrt(sum((Bx - Bx_EPS).^2 , 'all'));
RMS_y = sqrt(sum((By - By_EPS).^2 , 'all'));
RMS_z = sqrt(sum((Bz - Bz_EPS).^2 , 'all'));
RR = max([RMS , RMS_x , RMS_y , RMS_z]);
end

